# Copy to .env on the Pi and edit:  cp .env.example .env
# (.env holds your password - it is git-ignored; don't copy it around with the project.)

# ---------------------------------------------------------------- server ----
SERVER_NAME=Our Valheim
WORLD_NAME=Midgard
# At least 5 characters, and must not appear inside SERVER_NAME.
SERVER_PASSWORD=change-me-please
# 0 = not listed in the public server browser; join via IP (recommended for LAN).
SERVER_PUBLIC=0
# Anything else to pass to valheim_server (added after everything else).
# For world difficulty use the WORLD_* settings below instead.
EXTRA_SERVER_ARGS=
# Admins (can use cheats via the F5 console): SteamID64s, space or comma separated.
# Find yours in-game with F2 (shown as Steam_7656...). Empty = adminlist.txt is left as-is.
ADMIN_IDS=
# Optional: a free Steam Web API key (https://steamcommunity.com/dev/apikey) for
# `make player`. Without it, public Steam profiles are read without a key.
# With it you also get each player's total Valheim play time. Hidden by `make settings`.
STEAM_API_KEY=

# -------------------------------------------------------- world settings ----
# Valheim's world modifiers (the in-game "World settings"). Full guide, with
# what every level does: docs/world-settings.md. Applied on the next restart.
#  - Empty = not passed; the world keeps what it already has saved.
#  - Changes are SAVED INTO THE WORLD: emptying a setting later does NOT undo it.
#    To make this file the single source of truth, set WORLD_PRESET (e.g. normal):
#    a preset resets every modifier, then the ones below are applied on top.
#  - Back up first (make backup): some settings (e.g. hardcore death) are harsh.
# Preset: normal | casual | easy | hard | hardcore | immersive | hammer
WORLD_PRESET=
# Enemy damage/health/speed: veryeasy | easy | normal | hard | veryhard
WORLD_COMBAT=
# What you lose on death: casual | veryeasy | easy | normal | hard | hardcore
WORLD_DEATH_PENALTY=
# Resource drop amount: muchless | less | normal | more | muchmore | most
WORLD_RESOURCES=
# How often raids happen: none | muchless | less | normal | more | muchmore
WORLD_RAIDS=
# Portal rules: casual (ores/metals allowed) | normal | hard | veryhard
WORLD_PORTALS=
# On/off (1/0):
WORLD_NO_BUILD_COST=0
WORLD_PLAYER_EVENTS=0
WORLD_PASSIVE_MOBS=0
WORLD_NO_MAP=0

# ------------------------------------------------------------- host paths ----
# Point these at the USB SSD once it's mounted, e.g. /mnt/ssd/valheim/data
DATA_DIR=./data
BACKUP_DIR=./backups
# Must own DATA_DIR and BACKUP_DIR on the Pi (`id -u` / `id -g`).
PUID=1000
PGID=1000

# -------------------------------------------------------------- resources ----
# Cores the server may use. Core 0 is left free so the host stays responsive.
SERVER_CPUS=1-3
# Hard memory cap for the server (also its swap cap: no swapping). Needs the
# kernel's memory cgroup, which Raspberry Pi OS turns off by default - see
# docs/getting-started.md (step 5).
MEMORY_LIMIT=5g

# ---------------------------------------------------------------- updates ----
# 1 = download/update the server from Steam (DepotDownloader) on every start.
# 0 = skip and use the files already in DATA_DIR/server.
UPDATE_ON_START=1

# ------------------------------------------------- Valheim's own saves ----
# Seconds between world saves, and Valheim's built-in rolling backups (in DATA_DIR/worlds).
SAVE_INTERVAL=1800
VALHEIM_BACKUPS=4
VALHEIM_BACKUP_SHORT=7200
VALHEIM_BACKUP_LONG=43200

# ----------------------------------------------- snapshot backups (sidecar) ----
# Compressed tarballs of the whole worlds dir into BACKUP_DIR.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# ------------------------------------------------------------ box64 tuning ----
# Settings reported to stabilise the Valheim server under box64 (box64 issue #1182).
# If the server crashes ~20s after someone joins, try STRONGMEM=2 or 3 (slower, safer).
BOX64_DYNAREC_STRONGMEM=1
BOX64_DYNAREC_BIGBLOCK=0
BOX64_DYNAREC_BLEEDING_EDGE=0
BOX64_LOG=0
# Which box64 build to install, tuned per CPU (apply with `make build && make up`):
#   rpi4    Raspberry Pi 4 (default)     rpi3     Raspberry Pi 3
#   rk3399  RK3399 boards                tegrax1  Jetson Nano
#   generic any other 64-bit ARM (Raspberry Pi 5, RK3588, ...)
EMULATOR_BUILD=rpi4
# Optional: pin an exact apt version if a new box64 breaks Valheim (needs `make build`).
# List available versions with `make box-versions`.
# NOT "BOX64_VERSION": .env reaches box64, which reads every BOX64_* variable,
# and BOX64_VERSION makes it print its version and exit instead of running Valheim.
PIN_BOX64_VERSION=
